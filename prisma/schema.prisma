// Prisma schema for the Water Investment Summit Secure Project Portal.
// Models and field names follow docs/PLAN.md section 6 (data model v0.3). M1 (18 Nov) brought projects,
// teasers, submissions and country contacts in line; M3 (authz) removed pipeline scopes, ProjectGrant and the
// EXTRA/DATAROOM document kinds; M5 brought meeting requests in line.
// Ask before renaming or restructuring anything here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums (the bracketed values in PLAN section 6)
// ---------------------------------------------------------------------------

/// Not bracketed in the PLAN; ACTIVE countries take part in the current Summit.
enum CountryStatus {
  ACTIVE
  INACTIVE
}

enum MembershipRole {
  FOCAL_POINT
  MEMBER
}

enum ProjectType {
  SUMMIT_PIPELINE
  OTHER_PROPONENT
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum DocumentKind {
  TEASER
}

/// Not bracketed in the PLAN; result of the ClamAV scan. A file is visible only when CLEAN.
enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum UserRole {
  PLATFORM_ADMIN
  SUMMIT_ADMIN
  COUNTRY
  /// M2 (PLAN v0.3 section 4): reads its countries' requests and is copied on their notifications (M5).
  /// Its countries are CountryMembership rows (membership role ignored for this role).
  WBG_COORDINATOR
  INVESTOR
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  DEACTIVATED
  /// M13 (PLAN v0.4 0b.21): a self-registration the Summit team declined. Sees only the pending screen.
  REJECTED
}

/// M13 (PLAN v0.4 0b.16): what kind of organisation an investor or operator works for, asked at registration,
/// so countries can see the demand for their projects by organisation type.
enum OrganisationType {
  INFRASTRUCTURE_OPERATOR
  INVESTOR_FUND
  DFI_MDB
  COMMERCIAL_BANK
  ADVISER
  OTHER
}

enum MeetingRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  /// 23 Nov (admin meeting calendar): cancelled by the Summit team; the slot is freed and everyone is told.
  CANCELLED
}

/// PLAN v0.3 CountryContact.role. FOCAL_POINT: the country's request-inbox contact (by default the upload
/// link uploader); WBG_COORDINATOR: copied on that country's request notifications.
enum CountryContactRole {
  FOCAL_POINT
  WBG_COORDINATOR
}

enum SlotStatus {
  OPEN
  HELD
  BOOKED
  /// 23 Nov (admin meeting calendar): taken out of use by the Summit team; never offered to investors.
  BLOCKED
}

// ---------------------------------------------------------------------------
// Countries and people
// ---------------------------------------------------------------------------

model Country {
  id        String        @id @default(cuid())
  name      String        @unique
  iso3      String        @unique @db.Char(3)
  status    CountryStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  memberships CountryMembership[]
  projects    Project[]
  invitations Invitation[]
  uploadLinks UploadLink[]
  submissions Submission[]
  contacts    CountryContact[]
}

/// PLAN v0.3: a country's request-inbox contacts (focal points) and WBG coordinators. The uploader of a link
/// submission becomes a FOCAL_POINT contact unless they already are one (PLAN section 3). userId links the
/// contact to a portal account once there is one (M2/M3).
model CountryContact {
  id        String             @id @default(cuid())
  countryId String
  name      String
  /// Stored in lower case, so the unique key catches the same address typed differently.
  email     String
  role      CountryContactRole
  userId    String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([countryId, email, role])
  @@index([userId])
}

/// Links a COUNTRY user to the country workspace they belong to.
model CountryMembership {
  userId    String
  countryId String
  role      MembershipRole
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@id([userId, countryId])
  @@index([countryId])
}

/// Application user, also Better Auth's user model. Better Auth's two-factor flag is mapped onto
/// mfaEnabled (see src/lib/auth/auth.ts); emailVerified and image are fields Better Auth requires.
model User {
  id                     String            @id @default(cuid())
  email                  String            @unique
  name                   String
  organisation           String?
  /// M13 (PLAN v0.4 0b.16): asked at investor registration; empty for accounts made before or by admins.
  organisationType       OrganisationType?
  jobTitle               String?
  role                   UserRole
  status                 UserStatus        @default(PENDING_APPROVAL)
  mfaEnabled             Boolean           @default(false)
  termsAcceptedAt        DateTime?
  /// M2 (PLAN 0a.4): set when an admin hands out a temporary password; cleared when the person sets their own.
  mustChangePassword     Boolean           @default(false)
  /// M2: investor acknowledgement (PLAN v0.3 0.6), accepted once per user at first sign-in, again if the
  /// wording version in config changes. Investors see no pipeline before it.
  investorAckTextVersion String?
  investorAckAcceptedAt  DateTime?
  /// Required by Better Auth. True for invited users (the invitation link proves the address).
  emailVerified          Boolean           @default(false)
  /// Required by Better Auth; not used by the portal.
  image                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  sessions           Session[]
  accounts           Account[]
  twoFactors         TwoFactor[]
  memberships        CountryMembership[]
  documentsUploaded  Document[]          @relation("DocumentUploadedBy")
  countryContacts    CountryContact[]
  invitationsSent    Invitation[]        @relation("InvitationInvitedBy")
  meetingRequests    MeetingRequest[]    @relation("MeetingRequestRequester")
  meetingDecisions   MeetingRequest[]    @relation("MeetingRequestDecidedBy")
  auditEvents        AuditEvent[]
  uploadLinksCreated UploadLink[]        @relation("UploadLinkCreatedBy")

  @@index([role, status])
}

/// M13 (PLAN v0.4 0b.18, 0b.21): an organisation WBG pre-approved for the Summit. A registrant whose email
/// domain is one of `emailDomains` matches it (public email domains never match).
model ApprovedOrganisation {
  id           String            @id @default(cuid())
  name         String
  /// Lower-case domains without "@", for example "bank-one.example".
  emailDomains String[]
  /// Where the entry came from, for example "WBG list, 23 Nov".
  source       String            @default("")
  createdAt    DateTime          @default(now())
  contacts     ApprovedContact[]
}

/// M13 (PLAN v0.4 0b.18, 0b.21): a person WBG pre-approved by email address (lower case).
model ApprovedContact {
  email          String                @id
  organisationId String?
  organisation   ApprovedOrganisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())
}

model Invitation {
  id             String          @id @default(cuid())
  email          String
  role           UserRole
  countryId      String?
  /// Required when role is COUNTRY: the CountryMembership role created on accept.
  membershipRole MembershipRole?
  /// SHA-256 of the one-time token sent by email; the token itself is never stored.
  tokenHash      String          @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  createdAt      DateTime        @default(now())

  country   Country? @relation(fields: [countryId], references: [id])
  invitedBy User     @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([email])
  @@index([countryId])
  @@index([invitedById])
}

// ---------------------------------------------------------------------------
// Better Auth tables (M3). Field names follow Better Auth's schema; not part of PLAN section 5.
// ---------------------------------------------------------------------------

model Session {
  id        String   @id @default(cuid())
  userId    String
  /// Opaque session token (the cookie value is this token, signed).
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Sign-in method for a user. Only the "credential" provider (email + password) is used.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  /// Password hash (scrypt) for the credential provider. Never the password itself.
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

/// Short-lived values used by Better Auth (for example a pending second-step challenge).
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Authenticator app (TOTP) enrolment. Secret and backup codes are stored encrypted.
model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String
  secret                  String
  backupCodes             String
  /// False until the user has confirmed a code from the authenticator app.
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
}

// ---------------------------------------------------------------------------
// Teaser upload link (M0, PLAN v0.3 F0)
// ---------------------------------------------------------------------------

/// M0 (user decision, 18 Nov): a link governments use to upload teasers without an account, /submit/<token>.
/// One active link per country (countryId set, the country is fixed by the link) or one generic link
/// (countryId null, the uploader picks the country). Replaces PLAN v0.3's Country.uploadToken fields, so the
/// generic link and revoked links fit too. Only the SHA-256 of the token is stored; the URL is shown once.
model UploadLink {
  id          String    @id @default(cuid())
  countryId   String?
  /// SHA-256 (hex) of the random token in the URL; the token itself is never stored.
  tokenHash   String    @unique
  expiresAt   DateTime
  /// Set when an admin revokes the link or generates a new one for the same country.
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  /// Restrict: deleting a country must never turn its link into a generic one.
  country     Country?     @relation(fields: [countryId], references: [id], onDelete: Restrict)
  createdBy   User         @relation("UploadLinkCreatedBy", fields: [createdById], references: [id])
  submissions Submission[]

  @@index([countryId])
}

/// PLAN v0.3: one teaser upload with the uploader's single acknowledgement (wording version and time) for
/// every teaser in it. A teaser cannot be stored without one: Document.submissionId is required.
/// Through an upload link (uploadLinkId set, uploader from the form) or, since M1, in the portal workspace
/// (uploadLinkId null, uploader = the signed-in user; the audit event names the account).
model Submission {
  id                     String   @id @default(cuid())
  countryId              String
  /// The link used; null for a portal workspace upload (M1).
  uploadLinkId           String?
  uploaderName           String
  uploaderEmail          String
  /// "Represented government organisation" from the upload link form (ministry, utility or agency). Empty for
  /// portal workspace uploads and for submissions made before the question was added.
  governmentOrganisation String   @default("")
  /// M11 (PLAN v0.4 0b.2): the uploader's job title, required on the upload link form. Empty for portal
  /// workspace uploads and for submissions made before the question was added.
  uploaderJobTitle       String   @default("")
  ackTextVersion         String
  ackAcceptedAt          DateTime
  ip                     String?
  createdAt              DateTime @default(now())

  country    Country     @relation(fields: [countryId], references: [id])
  /// Restrict: deleting a link must never make its submissions look like portal uploads.
  uploadLink UploadLink? @relation(fields: [uploadLinkId], references: [id], onDelete: Restrict)
  /// Projects created by this submission (Project.submissionId).
  projects   Project[]
  /// Teaser files whose consent this submission records (Document.submissionId).
  documents  Document[]

  @@index([countryId, createdAt])
  @@index([uploadLinkId])
}

// ---------------------------------------------------------------------------
// Projects and documents
// ---------------------------------------------------------------------------

model Project {
  id               String        @id @default(cuid())
  countryId        String
  /// The submission that created the project (upload link). Each teaser file has its own Document.submissionId.
  submissionId     String?
  title            String
  sector           String
  /// M11 (PLAN v0.4 0b.8): region within the country (free text, from the WBG project list), entered by admins.
  region           String?
  projectType      ProjectType   @default(SUMMIT_PIPELINE)
  /// pppModel, size and developmentStage are entered by the admin team from the teasers (PLAN 0.5), not by
  /// governments. Chosen from the WBG lists (PLAN v0.4 0b.8); older values outside the lists are kept.
  pppModel         String?
  sizeMinUsd       Decimal?      @db.Decimal(16, 2)
  sizeMaxUsd       Decimal?      @db.Decimal(16, 2)
  developmentStage String?
  /// Not in PLAN v0.3 section 6; kept for the map (F12, M10; user decision 18 Nov). No form asks for them.
  lat              Float?
  lon              Float?
  status           ProjectStatus @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  country         Country          @relation(fields: [countryId], references: [id])
  submission      Submission?      @relation(fields: [submissionId], references: [id])
  documents       Document[]
  meetingRequests MeetingRequest[]

  @@index([countryId, status])
  @@index([submissionId])
  @@index([sector])
}

model Document {
  id             String       @id @default(cuid())
  projectId      String
  /// M1 (user decision, 18 Nov; not in PLAN section 6): the Submission whose acknowledgement covers this file.
  /// Required, so the database itself refuses a teaser without a Submission (CLAUDE.md).
  submissionId   String
  kind           DocumentKind
  filename       String
  version        Int          @default(1)
  /// PLAN v0.3: downloads allowed by default.
  allowDownload  Boolean      @default(true)
  /// Object key in the private bucket. Never a public URL.
  blobKey        String       @unique
  sha256         String       @db.Char(64)
  sizeBytes      Int
  scanStatus     ScanStatus   @default(PENDING)
  /// The portal account that uploaded the file; empty for upload link teasers (the Submission names the uploader).
  uploadedById   String?
  uploadedAt     DateTime     @default(now())
  /// Set when a newer version replaces this one.
  supersededById String?      @unique

  project      Project    @relation(fields: [projectId], references: [id])
  submission   Submission @relation(fields: [submissionId], references: [id])
  uploadedBy   User?      @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  supersededBy Document?  @relation("DocumentSupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   Document?  @relation("DocumentSupersededBy")

  @@index([projectId, kind])
  @@index([submissionId])
  @@index([uploadedById])
}

// ---------------------------------------------------------------------------
// Meeting requests, rooms and slots (F7, F8, F10)
// ---------------------------------------------------------------------------

/// PLAN v0.3 F5/F6 (M5): an investor asks for a bilateral meeting on a PUBLISHED project with their organisation,
/// role and a short note; no ranking and no limit. A country user of the project's country (or an admin, on behalf,
/// see the audit event) accepts or declines a PENDING request; decisions are final. The requester may withdraw it
/// while PENDING or ACCEPTED. The list is also the contact list exported after the Summit.
model MeetingRequest {
  id           String               @id @default(cuid())
  projectId    String
  requesterId  String
  /// As the investor typed it on the request (prefilled from User.organisation and User.jobTitle).
  organisation String
  role         String
  /// Short note, may be empty.
  note         String               @default("")
  /// Who will attend and how to reach them, as typed on the request (prefilled from the account). Empty on
  /// requests made before these fields were added: show the requester's account name and email instead.
  contactName  String               @default("")
  contactEmail String               @default("")
  status       MeetingRequestStatus @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  project   Project @relation(fields: [projectId], references: [id])
  requester User    @relation("MeetingRequestRequester", fields: [requesterId], references: [id])
  decidedBy User?   @relation("MeetingRequestDecidedBy", fields: [decidedById], references: [id])
  slot      Slot?

  @@index([projectId, status])
  @@index([requesterId, projectId])
}

model Room {
  id        String   @id @default(cuid())
  name      String   @unique
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots Slot[]
}

model Slot {
  id               String     @id @default(cuid())
  roomId           String
  startsAt         DateTime
  endsAt           DateTime
  status           SlotStatus @default(OPEN)
  /// Why the Summit team blocked this slot (BLOCKED only), shown on the admin calendar.
  blockedReason    String?
  meetingRequestId String?    @unique
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  meetingRequest MeetingRequest? @relation(fields: [meetingRequestId], references: [id], onDelete: SetNull)

  @@unique([roomId, startsAt])
  @@index([startsAt])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

/// Append-only audit trail. actorId is empty for failed logins and system actions.
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  ip         String?
  userAgent  String?
  at         DateTime @default(now())
  metadata   Json?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([actorId, at])
  @@index([entityType, entityId])
}
