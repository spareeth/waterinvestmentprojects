// Prisma schema for the Water Investment Summit Secure Project Portal.
// Models and field names follow docs/PLAN.md section 5 (data model v0.2) exactly.
// Ask before renaming or restructuring anything here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums (the bracketed values in PLAN section 5)
// ---------------------------------------------------------------------------

/// Not bracketed in the PLAN; ACTIVE countries take part in the current Summit.
enum CountryStatus {
  ACTIVE
  INACTIVE
}

enum MembershipRole {
  FOCAL_POINT
  MEMBER
}

enum ProjectTier {
  TIER1
  TIER2
}

enum ProjectType {
  SUMMIT_PIPELINE
  OTHER_PROPONENT
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum DocumentKind {
  TEASER
  EXTRA
  DATAROOM
}

/// Not bracketed in the PLAN; result of the ClamAV scan. A file is visible only when CLEAN.
enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum UserRole {
  PLATFORM_ADMIN
  SUMMIT_ADMIN
  COUNTRY
  INVESTOR
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  DEACTIVATED
}

/// Added in M4 (user decision, 17 Nov): which countries' PUBLISHED projects a user sees in the pipeline.
/// Admins see everything regardless; a country user's own workspace does not depend on it.
/// SELECTED means only the countries listed in PipelineCountry.
enum PipelineScope {
  NONE
  ALL
  SELECTED
}

enum MeetingRequestType {
  MEETING
  INFO
}

enum MeetingRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum SlotStatus {
  OPEN
  HELD
  BOOKED
}

enum GrantScope {
  EXTRA
}

// ---------------------------------------------------------------------------
// Countries and people
// ---------------------------------------------------------------------------

model Country {
  id        String        @id @default(cuid())
  name      String        @unique
  iso3      String        @unique @db.Char(3)
  status    CountryStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  memberships     CountryMembership[]
  projects        Project[]
  invitations     Invitation[]
  pipelineViewers PipelineCountry[]
}

/// Links a COUNTRY user to the country workspace they belong to.
model CountryMembership {
  userId    String
  countryId String
  role      MembershipRole
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@id([userId, countryId])
  @@index([countryId])
}

/// Added in M4: the countries whose published projects a user with pipelineScope SELECTED may see.
model PipelineCountry {
  userId    String
  countryId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@id([userId, countryId])
  @@index([countryId])
}

/// Application user, also Better Auth's user model. Better Auth's two-factor flag is mapped onto
/// mfaEnabled (see src/lib/auth/auth.ts); emailVerified and image are fields Better Auth requires.
model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String
  organisation    String?
  jobTitle        String?
  role            UserRole
  status          UserStatus    @default(PENDING_APPROVAL)
  mfaEnabled      Boolean       @default(false)
  termsAcceptedAt DateTime?
  /// M4: pipeline visibility. NONE by default (default deny); invitations set ALL for investors.
  pipelineScope   PipelineScope @default(NONE)
  /// Required by Better Auth. True for invited users (the invitation link proves the address).
  emailVerified   Boolean       @default(false)
  /// Required by Better Auth; not used by the portal.
  image           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sessions            Session[]
  accounts            Account[]
  twoFactors          TwoFactor[]
  memberships         CountryMembership[]
  pipelineCountries   PipelineCountry[]
  documentsUploaded   Document[]          @relation("DocumentUploadedBy")
  acknowledgements    Acknowledgement[]
  invitationsSent     Invitation[]        @relation("InvitationInvitedBy")
  meetingRequests     MeetingRequest[]    @relation("MeetingRequestRequester")
  meetingDecisions    MeetingRequest[]    @relation("MeetingRequestDecidedBy")
  projectGrants       ProjectGrant[]      @relation("ProjectGrantUser")
  projectGrantsIssued ProjectGrant[]      @relation("ProjectGrantGrantedBy")
  auditEvents         AuditEvent[]

  @@index([role, status])
}

model Invitation {
  id             String          @id @default(cuid())
  email          String
  role           UserRole
  countryId      String?
  /// Required when role is COUNTRY: the CountryMembership role created on accept.
  membershipRole MembershipRole?
  /// M4: copied to User.pipelineScope on accept. SELECTED countries are chosen on the user afterwards.
  pipelineScope  PipelineScope   @default(NONE)
  /// SHA-256 of the one-time token sent by email; the token itself is never stored.
  tokenHash      String          @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  createdAt      DateTime        @default(now())

  country   Country? @relation(fields: [countryId], references: [id])
  invitedBy User     @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([email])
  @@index([countryId])
  @@index([invitedById])
}

// ---------------------------------------------------------------------------
// Better Auth tables (M3). Field names follow Better Auth's schema; not part of PLAN section 5.
// ---------------------------------------------------------------------------

model Session {
  id        String   @id @default(cuid())
  userId    String
  /// Opaque session token (the cookie value is this token, signed).
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Sign-in method for a user. Only the "credential" provider (email + password) is used.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  /// Password hash (scrypt) for the credential provider. Never the password itself.
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

/// Short-lived values used by Better Auth (for example a pending second-step challenge).
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Authenticator app (TOTP) enrolment. Secret and backup codes are stored encrypted.
model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String
  secret                  String
  backupCodes             String
  /// False until the user has confirmed a code from the authenticator app.
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
}

// ---------------------------------------------------------------------------
// Projects, documents and acknowledgements
// ---------------------------------------------------------------------------

model Project {
  id                String        @id @default(cuid())
  countryId         String
  name              String
  sector            String
  tier              ProjectTier
  projectType       ProjectType   @default(SUMMIT_PIPELINE)
  pppModel          String?
  sizeMinUsd        Decimal?      @db.Decimal(16, 2)
  sizeMaxUsd        Decimal?      @db.Decimal(16, 2)
  tenderTimeline    String?
  documentsPrepared String?
  feedbackSought    String?
  revenueModel      String?
  counterparty      String?
  lat               Float?
  lon               Float?
  status            ProjectStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  country          Country           @relation(fields: [countryId], references: [id])
  documents        Document[]
  acknowledgements Acknowledgement[]
  meetingRequests  MeetingRequest[]
  grants           ProjectGrant[]

  @@index([countryId, status])
  @@index([status, tier])
  @@index([sector])
}

model Document {
  id             String       @id @default(cuid())
  projectId      String
  kind           DocumentKind
  title          String
  filename       String
  version        Int          @default(1)
  docDate        DateTime?    @db.Date
  allowDownload  Boolean      @default(false)
  /// Object key in the private bucket. Never a public URL.
  blobKey        String       @unique
  sha256         String       @db.Char(64)
  sizeBytes      Int
  scanStatus     ScanStatus   @default(PENDING)
  uploadedById   String
  uploadedAt     DateTime     @default(now())
  /// Set when a newer version replaces this one.
  supersededById String?      @unique

  project          Project           @relation(fields: [projectId], references: [id])
  uploadedBy       User              @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  supersededBy     Document?         @relation("DocumentSupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes       Document?         @relation("DocumentSupersededBy")
  acknowledgements Acknowledgement[]

  @@index([projectId, kind])
  @@index([uploadedById])
}

/// Confidentiality acknowledgement given before publishing. A project cannot be published without one.
model Acknowledgement {
  id                String   @id @default(cuid())
  projectId         String
  documentId        String
  userId            String
  textVersion       String
  acceptedAt        DateTime @default(now())
  ip                String?
  /// True when a Summit admin acknowledged for the country (evidence: the country's email).
  onBehalfOfCountry Boolean  @default(false)
  evidenceNote      String?

  project  Project  @relation(fields: [projectId], references: [id])
  document Document @relation(fields: [documentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([documentId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Meeting requests, rooms and slots (F7, F8, F10)
// ---------------------------------------------------------------------------

model MeetingRequest {
  id              String               @id @default(cuid())
  projectId       String
  requesterId     String
  type            MeetingRequestType
  message         String?
  rank            Int?
  status          MeetingRequestStatus @default(PENDING)
  decidedById     String?
  /// True when a Summit admin decided for the country.
  decidedOnBehalf Boolean              @default(false)
  decidedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  project   Project @relation(fields: [projectId], references: [id])
  requester User    @relation("MeetingRequestRequester", fields: [requesterId], references: [id])
  decidedBy User?   @relation("MeetingRequestDecidedBy", fields: [decidedById], references: [id])
  slot      Slot?

  @@index([projectId, status])
  @@index([requesterId])
}

model Room {
  id        String   @id @default(cuid())
  name      String   @unique
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots Slot[]
}

model Slot {
  id               String     @id @default(cuid())
  roomId           String
  startsAt         DateTime
  endsAt           DateTime
  status           SlotStatus @default(OPEN)
  meetingRequestId String?    @unique
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  meetingRequest MeetingRequest? @relation(fields: [meetingRequestId], references: [id], onDelete: SetNull)

  @@unique([roomId, startsAt])
  @@index([startsAt])
}

// ---------------------------------------------------------------------------
// Grants and audit (F11, audit log)
// ---------------------------------------------------------------------------

/// Explicit, expiring access to extra material on one project for one user.
model ProjectGrant {
  id          String     @id @default(cuid())
  userId      String
  projectId   String
  scope       GrantScope
  grantedById String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())

  user      User    @relation("ProjectGrantUser", fields: [userId], references: [id])
  project   Project @relation(fields: [projectId], references: [id])
  grantedBy User    @relation("ProjectGrantGrantedBy", fields: [grantedById], references: [id])

  @@index([userId, projectId])
  @@index([projectId])
}

/// Append-only audit trail. actorId is empty for failed logins and system actions.
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  ip         String?
  userAgent  String?
  at         DateTime @default(now())
  metadata   Json?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([actorId, at])
  @@index([entityType, entityId])
}
