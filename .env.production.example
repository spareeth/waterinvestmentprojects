# Server settings for compose.production.yml (M8). On the server: copy to .env next to compose.production.yml,
# fill in every CHANGE_ME, then `chmod 600 .env` (root-only). Never commit the filled-in file.
# Generate secrets with: openssl rand -base64 32   (passwords: openssl rand -hex 24, no special characters)

# --- Stack ---
COMPOSE_PROJECT_NAME=waterinvest
# The app listens on 127.0.0.1:APP_PORT; the reverse proxy forwards the domain to it. Pick a free port.
APP_PORT=3200

# --- Site (baked into the build: rebuild after changing APP_NAME, APP_URL, SUPPORT_EMAIL or INVESTOR_ACK_*) ---
APP_NAME="Water Investment Projects"
APP_URL="https://waterinvestmentprojects.org"
# production on the live server; staging on a test copy (allows the demo seed and UPLOAD_SCAN=assume-clean).
APP_ENV="production"
# Shared support mailbox shown on the landing page and the upload link. Empty hides the Contact section.
SUPPORT_EMAIL="summit@waterinvestmentprojects.org"

# --- Database (the db service; DATABASE_URL must use the same user, password and name) ---
POSTGRES_USER=portal
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=summit_portal
DATABASE_URL="postgresql://portal:CHANGE_ME@db:5432/summit_portal?schema=public"

# --- Sign-in ---
BETTER_AUTH_SECRET=CHANGE_ME
SELF_REGISTRATION_ENABLED="false"
AUTH_SECOND_STEP="none"
SESSION_IDLE_MINUTES="120"
SESSION_MAX_HOURS="12"
# Investor acknowledgement: leave both empty for the placeholder wording; set BOTH for WBG's final text.
INVESTOR_ACK_VERSION=""
INVESTOR_ACK_TEXT=""

# --- Uploaded files and virus scan ---
STORAGE_DRIVER="local"
# Every upload is scanned by the clamav service before anyone can open or publish it.
UPLOAD_SCAN="clamav"
CLAMAV_HOST="clamav"
CLAMAV_PORT="3310"
SCAN_SWEEP_SECONDS="60"

# --- Email from the Summit mailbox ---
# "smtp" once the mailbox exists; "log" writes emails to the app log instead (nothing is sent).
MAIL_DRIVER="smtp"
MAIL_FROM="summit@waterinvestmentprojects.org"
ADMIN_NOTIFY_EMAIL="summit@waterinvestmentprojects.org"
REQUEST_NOTIFY_FOCAL_POINTS="false"
REQUEST_NOTIFY_INVESTOR="false"
# From the mail provider. Microsoft 365: smtp.office365.com, 587, STARTTLS (SMTP AUTH must be enabled for the
# mailbox). Google Workspace: smtp.gmail.com, 587 (app password). Zoho: smtp.zoho.eu or smtp.zoho.com, 587.
SMTP_HOST=CHANGE_ME
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="summit@waterinvestmentprojects.org"
SMTP_PASSWORD=CHANGE_ME

# --- Demo data (staging only; never set on production) ---
ALLOW_DEMO_SEED=""
SEED_DEMO_PASSWORD=""

NEXT_TELEMETRY_DISABLED=1
