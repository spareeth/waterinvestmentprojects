# Copy to .env for local development. Real values for staging and production live only on the server, in a root-only .env file.
# Never commit .env or any real credential.

# PostgreSQL connection string. The value below matches docker-compose.yml (local only).
DATABASE_URL="postgresql://portal:portal_local_dev@localhost:5432/summit_portal?schema=public"

# Platform name and public URL. APP_URL is also the base URL for sign-in cookies, invitation links and upload
# links. Production: https://waterinvestmentprojects.org (the server's .env, not here).
APP_NAME="Water Investment Projects"
APP_URL="http://localhost:3000"

# Deployment environment: development, staging or production. Staging runs a production build, so this is what
# tells staging and production apart. If unset, it is "production" whenever NODE_ENV=production.
APP_ENV="development"

# Shared support mailbox (never a personal inbox) shown on the landing page and the upload link. Leave empty to
# hide the Contact section. The landing page is pre-rendered, so rebuild after changing this (or APP_NAME).
SUPPORT_EMAIL=""

# --- Sign-in (Better Auth) ---
# Signs session cookies and encrypts two-step secrets. At least 32 random characters, different per environment.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# M13 (PLAN v0.4 0b.17): investors and operators register at /register (on unless "false"). Registrations wait
# for a Summit admin unless REGISTRATION_AUTO_APPROVE="true" lets a pre-approved email or domain straight in
# (off: emails are not verified yet). REGISTRATION_NOTIFY_REGISTRANT="true" emails the outcome (off until the
# mailbox reaches inboxes).
SELF_REGISTRATION_ENABLED="true"
REGISTRATION_AUTO_APPROVE="false"
REGISTRATION_NOTIFY_REGISTRANT="false"

# Second step at sign-in (PLAN 0a.3, 18 Nov: email and password only for now). "none" (default) asks for no second
# step; "totp" requires an authenticator app (kept from the old M3). Email codes follow once the mailbox is live.
AUTH_SECOND_STEP="none"

# Investor acknowledgement (accepted once per investor at first sign-in). Empty = the placeholder wording in
# src/lib/config.ts. Set BOTH to put in WBG's final text; a new version asks every investor again.
INVESTOR_ACK_VERSION=""
INVESTOR_ACK_TEXT=""

# Session timeout: signed out after this many minutes without activity, and this many hours after signing in.
SESSION_IDLE_MINUTES="120"
SESSION_MAX_HOURS="12"

# --- Uploaded files ---
# Storage backend: "local" (files under STORAGE_LOCAL_DIR, git-ignored). S3-compatible storage (MinIO) follows in M10.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/blobs"

# Virus scan. "clamav" (servers, M8) scans every upload with clamd at CLAMAV_HOST:CLAMAV_PORT before it can be
# opened or published. "pending" keeps uploads PENDING, so they cannot be opened or published. "assume-clean"
# marks uploads CLEAN at once without scanning: local and staging demos only. The server refuses to start with
# it when APP_ENV=production. Server settings: .env.production.example.
UPLOAD_SCAN="pending"
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"
SCAN_SWEEP_SECONDS="60"

# --- Email (from the Summit mailbox) ---
# "log" writes each email to the server log instead of sending it (outside APP_ENV=development only recipients
# and subject). "smtp" sends through SMTP_HOST. Locally, `npm run mail:up` starts Mailpit: use SMTP_HOST=localhost,
# SMTP_PORT=1025, no user or password, and read the inbox at http://localhost:8025.
# On the server: the provider's SMTP details for summit@waterinvestmentprojects.org (port 587 with STARTTLS, or
# 465 with SMTP_SECURE="true"); SMTP_PASSWORD only in the server's root-only .env.
MAIL_DRIVER="log"
MAIL_FROM="summit@waterinvestmentprojects.org"
# Summit team mailbox told about every teaser submission and every meeting request (later also projects).
ADMIN_NOTIFY_EMAIL="summit@waterinvestmentprojects.org"
# Meeting request emails beyond the Summit mailbox, off until WBG decides (M5): to the country's focal points
# (WBG coordinator in copy) on each new request, and to the investor on accept or decline.
REQUEST_NOTIFY_FOCAL_POINTS="false"
REQUEST_NOTIFY_INVESTOR="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Demo data ---
# The demo seed (npm run db:seed) refuses to run with NODE_ENV=production unless this is "true".
# Set it on staging only. Never on production.
ALLOW_DEMO_SEED=""

# Password given to every demo user by the seed. Optional locally (the README documents the local default);
# required on staging, where it must be a value known only to the demo team.
SEED_DEMO_PASSWORD=""

# Opt out of Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1
